{
  "schema_version": 1,
  "seed": 2026,
  "dataset_manifest": "artifacts/manifests/quality_dataset_formal_seed2026.json",
  "formal_counts": {"train": 1518, "val": 760, "test": 607, "blind": 608},
  "selection": {
    "primary": "val.oqi_srcc",
    "tie_breaker": "val.oqi_mae",
    "test_blind_policy": "evaluate only the single Val-selected winner",
    "train_tile_leave_one_out": "diagnostic only; never replaces Val selection"
  },
  "runs": [
    {
      "id": "B0_formal_frozen",
      "base": "frozen",
      "normalization": "train_mean_std_plus_sample_layernorm",
      "sampler": "sample_uniform",
      "domain_loss": "none"
    },
    {
      "id": "B1_formal_frozen_tile_dg",
      "base": "frozen",
      "normalization": "train_robust_median_iqr_plus_sample_layernorm",
      "sampler": "tile_balanced",
      "domain_loss": "smooth_worst_tile_logsumexp_over_five_train_tiles",
      "quality_style_mixup": {"enabled": false, "reason": "defer until the isolated GroupDRO result is known"}
    },
    {
      "id": "B2_partial_unfreeze",
      "base": "unfreeze_last_mesh_and_texture_blocks",
      "head_lr": 0.0005,
      "base_lr_ratio": 0.05,
      "sampler": "tile_balanced",
      "domain_loss": "smooth_worst_tile_logsumexp_over_five_train_tiles"
    },
    {
      "id": "B3_quality_e2e",
      "base": "all_trainable",
      "head_lr": 0.0003,
      "base_lr_ratio": 0.01,
      "max_epochs": 30,
      "sampler": "tile_balanced",
      "domain_loss": "smooth_worst_tile_logsumexp_over_five_train_tiles"
    }
  ],
  "promotion_gate": {
    "minimum_val_oqi_srcc_gain_over_B0": 0.01,
    "maximum_allowed_val_geometry_srcc_drop": 0.02,
    "maximum_allowed_val_texture_srcc_drop": 0.02
  }
}
